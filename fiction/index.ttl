pf:我的固定模式，和它的上限 a pf:Method ;
    rdfs:label "我的固定模式，和它的上限" ;
    pf:file "2_创作方法.md" .

pf:素材要迁到最合适的位置 a pf:Method ;
    rdfs:label "素材要迁到最合适的位置" ;
    pf:file "2_创作方法.md" .

pf:现实的映射与代入感 a pf:Method ;
    rdfs:label "现实的映射与代入感" ;
    pf:file "2_创作方法.md" .

pf:墙与瓶颈 a pf:Method ;
    rdfs:label "墙与瓶颈" ;
    pf:file "2_创作方法.md" .

pf:视角 a pf:Method ;
    rdfs:label "视角" ;
    pf:file "2_创作方法.md" .

pf:读者反馈 a pf:Method ;
